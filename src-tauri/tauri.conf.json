{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GatherPack",
  "version": "0.1.0-alpha.13",
  "identifier": "io.github.dogchenya.gatherpack",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "GatherPack · 文件收集与打包",
        "width": 104,
        "height": 112,
        "minWidth": 80,
        "minHeight": 80,
        "maxWidth": 104,
        "maxHeight": 112,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Collect files and folders into ZIP, 7z and tar.gz archives",
    "category": "Utility",
    "linux": {
      "deb": {
        "depends": [
          "libc6 (>= 2.35)",
          "python3-gi",
          "python3-nautilus",
          "python3-pyatspi",
          "gir1.2-gtk-3.0",
          "gir1.2-gtk-4.0",
          "x11-utils"
        ],
        "files": {
          "/usr/share/nautilus-python/extensions/gatherpack_selection.py": "scripts/gatherpack_selection.py"
        }
      }
    },
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../docs/THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../docs/third-party.md": "licenses/third-party.md",
      "../docs/license-audit.json": "licenses/license-audit.json",
      "../docs/installer-notices/Rust-COPYRIGHT-library.html": "licenses/Rust-COPYRIGHT-library.html"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "Info.plist"
    }
  }
}
